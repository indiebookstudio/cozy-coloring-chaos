    "en": {
      "01-regali": {
        "eyebrow": "CHRISTMAS, OUR WAY",
        "title": "Give a little beautiful chaos.",
        "body": "Coloring books, pixel worlds and an irreverent notebook: gift ideas for people who love something different.",
        "cta": "Find your gift"
      },

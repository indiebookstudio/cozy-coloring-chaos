# ============================================================================
# COZY COLORING CHAOS - ENVIRONMENT CONFIGURATION (EXAMPLE)
# ============================================================================
# Rename or copy this file to .env and set your private keys.
# NEVER commit the actual .env file to Git!

# Brevo (Sendinblue) API Key (obtain from https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=your_brevo_api_key_here

# Local Development Server Port (default: 3000)
PORT=3000

# Allowed CORS Origin (comma-separated if multiple; defaults to indiebookstudio.github.io and localhost)
# ALLOWED_ORIGINS=https://indiebookstudio.github.io,http://localhost:3000

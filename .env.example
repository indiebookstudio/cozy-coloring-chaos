# ============================================================================
# COZY COLORING CHAOS - ENVIRONMENT CONFIGURATION (EXAMPLE)
# ============================================================================
# Rename or copy this file to .env and set your private keys.
# NEVER commit the actual .env file to Git!

# Brevo (Sendinblue) API Key (obtain from https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=your_brevo_api_key_here

# Local Development Server Port (default: 3000)
PORT=3000

# Single Admin Authentication
# Generate SHA-256 hash of your admin password (e.g. echo -n "mypassword" | sha256sum)
ADMIN_PASSWORD_HASH=your_admin_password_sha256_hash_here
# Random secret string for signing session cookies
ADMIN_SESSION_SECRET=your_random_session_secret_here

# Optional: Supabase PostgreSQL Database (for production fan videos metadata)
# If omitted, system defaults to local data/fan-videos.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Or direct PostgreSQL connection string
DATABASE_URL=

# Allowed CORS Origin (comma-separated if multiple; defaults to indiebookstudio.github.io and localhost)
# ALLOWED_ORIGINS=https://indiebookstudio.github.io,http://localhost:3000
